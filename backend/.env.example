# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# --- Database (PostgreSQL) ---
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
postgresql://gwins_readers_db_user:CDIWVDvao0TbECeMlgTlukMTRYepBVIn@dpg-d9ni0s67bikc73c0002g-a/gwins_readers_db

# --- Cloudinary (media storage: avatars, book files/covers, opportunity
#     logos, training-session materials) ---
# Find these under Cloudinary Dashboard -> Go to API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: groups all of this app's uploads under one folder in the
# Cloudinary media library. Defaults to "gwins_readers_club" if unset.
# CLOUDINARY_ROOT_FOLDER=gwins_readers_club

